{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision-brief.schema.json",
  "title": "Decision brief",
  "description": "One owner-facing brief for one open item that needs the owner's decision. The question is plain language (no code identifiers); today carries one concrete example checked against calendars.yaml/products.yaml; impact always answers whether any market stops publishing; options map one-to-one to the underlying request's option ids; every time, count or duration cites the config or code it read; the original message/finding/file:line stays in evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "question", "today", "impact", "options", "recommendation", "related", "evidence"],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "today": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/briefOption" }
    },
    "recommendation": { "$ref": "#/$defs/briefRecommendation" },
    "related": {
      "type": "array",
      "items": { "$ref": "#/$defs/briefRelated" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "briefOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "effect", "cost"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "effect": { "type": "string", "minLength": 1 },
        "cost": { "type": "string", "minLength": 1 }
      }
    },
    "briefRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "why"],
      "properties": {
        "option": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "briefRelated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 }
      }
    }
  }
}
