{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/review",
  "title": "Review",
  "description": "design §6.3: per-reviewer, bound to (candidate, contract version), with per-correction honored/not_honored and per-finding confirm/withdraw statements.",
  "type": "object",
  "required": ["reviewer", "phaseId", "candidateSha", "contractVersion", "correctionStatements", "findingStatements"],
  "additionalProperties": true,
  "properties": {
    "reviewer": { "enum": ["M", "A", "B"] },
    "phaseId": { "type": "string", "minLength": 1 },
    "candidateSha": { "type": "string", "minLength": 1 },
    "contractVersion": { "$ref": "#/$defs/ContractVersion" },
    "correctionStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["correctionId", "status"],
        "additionalProperties": false,
        "properties": {
          "correctionId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["honored", "not_honored"] }
        }
      }
    },
    "findingStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "status"],
        "additionalProperties": false,
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirm", "withdraw"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "ballots": {
      "type": "array",
      "description": "Work packet 2a: turn 2 of a real review — a ballot per votable decision.",
      "items": {
        "type": "object",
        "required": ["decisionId", "vote", "rationale", "evidence"],
        "additionalProperties": false,
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "vote": { "enum": ["approve", "reject"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contractObjection": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Work packet 2a: newly raised findings, with evidence + severity (design §4.1).",
      "items": {
        "type": "object",
        "required": ["kind", "severity", "evidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["defect", "contract", "integration"] },
          "severity": { "enum": ["blocking", "advisory"] },
          "evidence": { "type": "string", "minLength": 1 },
          "linkedDecisionId": { "type": "string", "minLength": 1 },
          "sameAs": { "type": "string", "minLength": 1 },
          "reproduction": {
            "type": "object",
            "required": ["command"],
            "additionalProperties": false,
            "properties": { "command": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "discoveryMatches": {
      "type": "array",
      "description": "Plan 2c: for each of this reviewer's own turn-1 discoveries that is the same choice as another listed record, {discoveryId, sameAs}.",
      "items": {
        "type": "object",
        "required": ["discoveryId", "sameAs"],
        "additionalProperties": false,
        "properties": {
          "discoveryId": { "type": "string", "minLength": 1 },
          "sameAs": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
