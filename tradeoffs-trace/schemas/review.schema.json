{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/review",
  "title": "Review",
  "description": "design §6.3: per-reviewer, bound to (candidate, contract version), with per-correction honored/not_honored and per-finding confirm/withdraw statements.",
  "type": "object",
  "required": ["reviewer", "phaseId", "candidateSha", "contractVersion", "correctionStatements", "findingStatements"],
  "additionalProperties": true,
  "properties": {
    "reviewer": { "type": "string", "minLength": 1, "description": "Plan 06h: any seat #+TT_REVIEWERS declares (default M A B)." },
    "phaseId": { "type": "string", "minLength": 1 },
    "candidateSha": { "type": "string", "minLength": 1 },
    "contractVersion": { "$ref": "#/$defs/ContractVersion" },
    "correctionStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["correctionId", "status"],
        "additionalProperties": false,
        "properties": {
          "correctionId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["honored", "not_honored"] }
        }
      }
    },
    "findingStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "status"],
        "additionalProperties": false,
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirm", "withdraw"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Plan 06b: a verdict for every requirement and constraint (met/unmet/partial, with evidence).",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "evidence"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["met", "unmet", "partial"] },
          "evidence": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "arch": {
      "type": "array",
      "description": "Plan 06b: a verdict for every architecture item (fits/deviates/unclear, with evidence).",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "evidence"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["fits", "deviates", "unclear"] },
          "evidence": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "ballots": {
      "type": "array",
      "description": "Work packet 2a: turn 2 of a real review — a ballot per votable decision.",
      "items": {
        "type": "object",
        "required": ["decisionId", "vote", "rationale", "evidence"],
        "additionalProperties": false,
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "vote": { "enum": ["approve", "reject"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contractObjection": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Work packet 2a: newly raised findings, with evidence + severity (design §4.1).",
      "items": {
        "type": "object",
        "required": ["kind", "severity", "evidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["defect", "contract", "integration"] },
          "severity": { "enum": ["blocking", "advisory"] },
          "evidence": { "type": "string", "minLength": 1 },
          "linkedDecisionId": { "type": "string", "minLength": 1 },
          "sameAs": { "type": "string", "minLength": 1 },
          "criterionDispute": {
            "type": "object",
            "description": "Plan 01g: this finding is that a criterion cannot be met as written; the conductor records an amendment decision and the finding cites it.",
            "required": ["criterion", "why", "proposedWording"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 },
              "proposedWording": { "type": "string", "minLength": 1 }
            }
          },
          "reproduction": {
            "type": "object",
            "required": ["command"],
            "additionalProperties": false,
            "properties": { "command": { "type": "string", "minLength": 1 } }
          },
          "runnable": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": {
      "type": "array",
      "description": "Plan 04b: the reviewer's separate blockers list — 'stop the work until the owner decides'. Each is raised as a raw `blocker` message AND a blocking finding, effective at once, and voted by a panel; a blocker is NEVER folded into an existing finding (no `sameAs`), so a stop-the-work request can never be silently dropped.",
      "items": {
        "type": "object",
        "required": ["kind", "evidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["defect", "contract", "integration"] },
          "evidence": { "type": "string", "minLength": 1 },
          "linkedDecisionId": { "type": "string", "minLength": 1 },
          "criterionDispute": {
            "type": "object",
            "required": ["criterion", "why", "proposedWording"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 },
              "proposedWording": { "type": "string", "minLength": 1 }
            }
          },
          "reproduction": {
            "type": "object",
            "required": ["command"],
            "additionalProperties": false,
            "properties": { "command": { "type": "string", "minLength": 1 } }
          },
          "runnable": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resolutionStatements": {
      "type": "array",
      "description": "Plan 05e: this reviewer's mark on every earlier-round finding/blocker the turn-2 prompt listed.",
      "items": {
        "type": "object",
        "required": ["messageId", "status"],
        "additionalProperties": false,
        "properties": {
          "messageId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["resolved", "open"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "discoveryMatches": {
      "type": "array",
      "description": "Plan 2c: for each of this reviewer's own turn-1 discoveries that is the same choice as another listed record, {discoveryId, sameAs}.",
      "items": {
        "type": "object",
        "required": ["discoveryId", "sameAs"],
        "additionalProperties": false,
        "properties": {
          "discoveryId": { "type": "string", "minLength": 1 },
          "sameAs": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
