{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/phase-contract",
  "title": "Phase contract",
  "description": "The frozen contract a phase is evaluated against: one phase of one plan snapshot (design §1.1, §7.1).",
  "type": "object",
  "required": ["phaseId", "contractVersion", "goal", "acceptance", "checks", "boundaries", "reserved"],
  "additionalProperties": false,
  "properties": {
    "phaseId": { "type": "string", "minLength": 1 },
    "contractVersion": { "$ref": "#/$defs/ContractVersion" },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reserved": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
