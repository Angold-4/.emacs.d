{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/owner-command",
  "title": "Owner command",
  "description": "design §7.4: every owner command kind, each bound to what it evaluated. The flat 'kind' forms below are the conductor's own encoding; the decision view (design §10.4, core/init-tradeoffs-trace.el) writes the alternative `type` + binding form, accepted by the same conductor (see the DV* defs, each with its own required binding so the published schema validates what it names).",
  "oneOf": [
    { "$ref": "#/$defs/Steer" },
    { "$ref": "#/$defs/Note" },
    { "$ref": "#/$defs/Resolve" },
    { "$ref": "#/$defs/Override" },
    { "$ref": "#/$defs/AcceptFinding" },
    { "$ref": "#/$defs/Revise" },
    { "$ref": "#/$defs/Amend" },
    { "$ref": "#/$defs/Unneeded" },
    { "$ref": "#/$defs/Miss" },
    { "$ref": "#/$defs/PauseResumeMode" },
    { "$ref": "#/$defs/DVResolve" },
    { "$ref": "#/$defs/DVOverride" },
    { "$ref": "#/$defs/DVAcceptFinding" },
    { "$ref": "#/$defs/DVRevise" },
    { "$ref": "#/$defs/DVAmend" },
    { "$ref": "#/$defs/DVNote" },
    { "$ref": "#/$defs/DVUnneeded" },
    { "$ref": "#/$defs/DVMiss" }
  ],
  "$defs": {
    "RecordBinding": {
      "description": "The design §7.1 binding tuple for a record-level decision-view command (design §10.4): the full tuple, so the published schema — not only the conductor's normalizer — rejects a command that names no record version, candidate or contract.",
      "type": "object",
      "required": ["runId", "phaseId", "candidateSha", "contractVersion", "recordId", "recordVersion"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "phaseId": { "type": "string", "minLength": 1 },
        "candidateSha": { "type": "string", "minLength": 1 },
        "contractVersion": { "$ref": "#/$defs/ContractVersion" },
        "recordId": { "type": "string", "minLength": 1 },
        "recordVersion": { "type": "integer" }
      }
    },
    "NoteBinding": {
      "description": "A note is bound only to the run and phase it is queued for (design §7.4): no candidate exists and no record is targeted.",
      "type": "object",
      "required": ["runId", "phaseId"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "phaseId": { "type": "string", "minLength": 1 }
      }
    },
    "DVResolve": {
      "description": "Decision view (design §10.4): resolve an owner request by option id. `note` carries the scope an open_finding accept_risk option requires (design §4.2).",
      "type": "object",
      "required": ["type", "binding", "option"],
      "properties": {
        "type": { "const": "resolve" },
        "recordKind": { "type": "string", "minLength": 1 },
        "option": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVOverride": {
      "description": "Decision view (design §10.4): override a delegated decision.",
      "type": "object",
      "required": ["type", "binding", "vote"],
      "properties": {
        "type": { "const": "override" },
        "recordKind": { "type": "string", "minLength": 1 },
        "vote": { "enum": ["approve", "reject"] },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVAcceptFinding": {
      "description": "Decision view (design §10.4): accept a finding with a required scope.",
      "type": "object",
      "required": ["type", "binding", "scope"],
      "properties": {
        "type": { "const": "accept-finding" },
        "recordKind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVRevise": {
      "description": "Decision view (design §10.4): correct a decision or finding and repair.",
      "type": "object",
      "required": ["type", "binding", "text"],
      "properties": {
        "type": { "const": "revise" },
        "recordKind": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "changesContract": { "type": "boolean" },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVAmend": {
      "description": "Decision view (design §10.4): amend the phase contract to a new version.",
      "type": "object",
      "required": ["type", "binding", "newContractVersion"],
      "properties": {
        "type": { "const": "amend" },
        "recordKind": { "type": "string", "minLength": 1 },
        "replacingContractVersion": { "$ref": "#/$defs/ContractVersion" },
        "newContractVersion": { "$ref": "#/$defs/ContractVersion" },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVNote": {
      "description": "Decision view (design §10.4): queue a note for the next worker attempt.",
      "type": "object",
      "required": ["type", "binding", "text"],
      "properties": {
        "type": { "const": "note" },
        "text": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/NoteBinding" }
      }
    },
    "DVUnneeded": {
      "description": "Decision view (design §10.4): record an owner request as \"did not need me\".",
      "type": "object",
      "required": ["type", "binding"],
      "properties": {
        "type": { "const": "unneeded" },
        "recordKind": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "DVMiss": {
      "description": "Decision view (design §10.4): mark a sampled record as a miss.",
      "type": "object",
      "required": ["type", "binding"],
      "properties": {
        "type": { "const": "miss" },
        "recordKind": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/RecordBinding" }
      }
    },
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "Steer": {
      "type": "object",
      "required": ["kind", "text", "boundAttemptId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "steer" },
        "text": { "type": "string", "minLength": 1 },
        "boundAttemptId": { "type": "string", "minLength": 1 }
      }
    },
    "Note": {
      "type": "object",
      "required": ["kind", "text", "phaseId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "note" },
        "text": { "type": "string", "minLength": 1 },
        "phaseId": { "type": "string", "minLength": 1 }
      }
    },
    "Resolve": {
      "type": "object",
      "required": ["kind", "requestId", "requestVersion", "option", "boundCandidateSha", "boundContractVersion"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "resolve" },
        "requestId": { "type": "string", "minLength": 1 },
        "requestVersion": { "type": "integer" },
        "option": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "boundCandidateSha": { "type": "string", "minLength": 1 },
        "boundContractVersion": { "$ref": "#/$defs/ContractVersion" }
      }
    },
    "Override": {
      "type": "object",
      "required": ["kind", "decisionId", "decisionVersion", "vote", "boundCandidateSha", "boundContractVersion"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "override" },
        "decisionId": { "type": "string", "minLength": 1 },
        "decisionVersion": { "type": "integer" },
        "vote": { "enum": ["approve", "reject"] },
        "boundCandidateSha": { "type": "string", "minLength": 1 },
        "boundContractVersion": { "$ref": "#/$defs/ContractVersion" }
      }
    },
    "AcceptFinding": {
      "type": "object",
      "required": ["kind", "findingId", "findingVersion", "scope", "boundCandidateSha", "boundContractVersion"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "accept-finding" },
        "findingId": { "type": "string", "minLength": 1 },
        "findingVersion": { "type": "integer" },
        "scope": { "type": "string", "minLength": 1 },
        "boundCandidateSha": { "type": "string", "minLength": 1 },
        "boundContractVersion": { "$ref": "#/$defs/ContractVersion" }
      }
    },
    "Revise": {
      "type": "object",
      "required": [
        "kind", "targetRecordId", "targetRecordVersion", "correctionText",
        "contractChange", "boundCandidateSha", "boundContractVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "revise" },
        "targetRecordId": { "type": "string", "minLength": 1 },
        "targetRecordVersion": { "type": "integer" },
        "correctionText": { "type": "string", "minLength": 1 },
        "contractChange": { "type": "boolean" },
        "boundCandidateSha": { "type": "string", "minLength": 1 },
        "boundContractVersion": { "$ref": "#/$defs/ContractVersion" }
      }
    },
    "Amend": {
      "type": "object",
      "required": ["kind", "phaseId", "replacingContractVersion", "newContractVersion"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "amend" },
        "phaseId": { "type": "string", "minLength": 1 },
        "replacingContractVersion": { "$ref": "#/$defs/ContractVersion" },
        "newContractVersion": { "$ref": "#/$defs/ContractVersion" }
      }
    },
    "Unneeded": {
      "type": "object",
      "required": ["kind", "requestId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "unneeded" },
        "requestId": { "type": "string", "minLength": 1 }
      }
    },
    "Miss": {
      "type": "object",
      "required": ["kind", "recordId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "miss" },
        "recordId": { "type": "string", "minLength": 1 },
        "sample": { "type": "string", "minLength": 1 }
      }
    },
    "PauseResumeMode": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["pause", "resume", "mode"] },
        "mode": { "enum": ["delegate", "co-work"] }
      }
    }
  }
}
