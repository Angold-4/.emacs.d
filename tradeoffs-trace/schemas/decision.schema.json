{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/decision",
  "title": "Decision",
  "description": "design §3.2, §3.4. All plain-language fields are required and must be non-empty.",
  "type": "object",
  "required": [
    "id", "version", "phaseId", "source", "class", "choice", "whyItMatters",
    "alternatives", "recommendation", "boundCandidateSha", "boundContractVersion"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer" },
    "phaseId": { "type": "string", "minLength": 1 },
    "source": { "enum": ["worker", "reviewer-discovered", "trigger"] },
    "class": { "enum": ["detail", "delegated", "reserved"] },
    "choice": { "type": "string", "minLength": 1 },
    "whyItMatters": { "type": "string", "minLength": 1 },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Alternative" }
    },
    "recommendation": { "$ref": "#/$defs/Recommendation" },
    "linkedFindingId": { "type": "string", "minLength": 1 },
    "boundCandidateSha": { "type": "string", "minLength": 1 },
    "boundContractVersion": { "$ref": "#/$defs/ContractVersion" },
    "supersededByCorrection": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "Alternative": {
      "type": "object",
      "required": ["option", "consequence"],
      "additionalProperties": false,
      "properties": {
        "option": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": ["choice", "reason"],
      "additionalProperties": false,
      "properties": {
        "choice": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
