{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/submission",
  "title": "Submission",
  "description": "Model-facing shapes for the submit_phase and submit_discovery tools (design §3.2): the plain-language decision-disclosure fields a worker or reviewer can supply, before the conductor assigns id, version, phaseId, source, boundCandidateSha and boundContractVersion once a candidate exists (see decision.schema.json, and README's phase-1 note on that step). decisionDisclosure's choice/whyItMatters/alternatives/recommendation fields, and the Alternative/Recommendation $defs, are kept identical to decision.schema.json's own — a contract test (test/contract/submission-schema.test.ts) enforces that. submit_review needs no such split: schemas/review.schema.json is used for it directly, since a Review carries no conductor-assigned binding fields at all.",
  "$defs": {
    "Alternative": {
      "type": "object",
      "required": ["option", "consequence"],
      "additionalProperties": false,
      "properties": {
        "option": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": ["choice", "reason"],
      "additionalProperties": false,
      "properties": {
        "choice": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "decisionDisclosure": {
      "type": "object",
      "required": ["choice", "whyItMatters", "alternatives", "recommendation", "classProposal"],
      "additionalProperties": true,
      "properties": {
        "choice": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Alternative" }
        },
        "recommendation": { "$ref": "#/$defs/Recommendation" },
        "classProposal": { "enum": ["detail", "delegated", "reserved"] }
      }
    },
    "submitPhase": {
      "type": "object",
      "required": ["decisions", "assumptions", "deviations"],
      "additionalProperties": true,
      "properties": {
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionDisclosure" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deviations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priorDecisions": {
          "type": "array",
          "description": "Plan 2c, repair attempts only: kept, changed (with the new text) or withdrawn, for each prior decision listed in the repair prompt.",
          "items": { "$ref": "#/$defs/priorDecision" }
        },
        "criterionDispute": {
          "$ref": "#/$defs/criterionDispute",
          "description": "Plan 01g: say a criterion cannot be met as written, naming it verbatim; the conductor records an amendment the reviewers vote on. A criterion that is merely unmet is a normal repair, not a dispute."
        }
      }
    },
    "criterionDispute": {
      "type": "object",
      "required": ["criterion", "why", "proposedWording"],
      "additionalProperties": false,
      "description": "Plan 01g: a criterion the worker says cannot be met as written. `criterion` names one acceptance item of the phase contract verbatim; the conductor records an amendment (a reserved decision) the reviewers vote on.",
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "proposedWording": { "type": "string", "minLength": 1 }
      }
    },
    "priorDecision": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["kept", "changed", "withdrawn"] },
        "choice": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Alternative" } },
        "recommendation": { "$ref": "#/$defs/Recommendation" }
      }
    },
    "submitDiscovery": {
      "type": "object",
      "required": ["discoveries"],
      "additionalProperties": true,
      "properties": {
        "discoveries": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/decisionDisclosure" }
        }
      }
    }
  }
}
