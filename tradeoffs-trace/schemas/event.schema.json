{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/event",
  "title": "Event",
  "description": "Every event type reduce() understands (design §6.1, §8.1, §9.3, §7.3, §7.5, §6.4, §7.1). Each is an object with a 'type' discriminant plus whatever payload that transition needs; unlisted 'type' values are invalid.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": [
        "ATTEMPT_STARTED", "BASELINE_COMPLETED", "BASELINE_TIMED_OUT", "BASELINE_INTERRUPTED",
        "EVALUATION_COMPLETED", "EVALUATION_TIMED_OUT", "EVALUATION_INTERRUPTED", "EVALUATOR_FINISHED",
        "PANEL_VOTE", "PANEL_SEAT_UNAVAILABLE", "PANEL_DECIDED",
        "SUBMIT_PHASE", "ATTEMPT_TIMED_OUT", "ATTEMPT_NO_SUBMISSION",
        "ATTEMPT_INTERRUPTED", "FREEZE_COMPLETED", "FREEZE_TIMED_OUT", "FREEZE_INTERRUPTED",
        "CHECKS_PASSED", "CHECKS_FAILED", "CHECKS_INTERRUPTED", "PROBE_PASSED", "PROBE_FAILED",
        "PROBE_INTERRUPTED", "REVIEW_SUBMITTED", "REVIEW_TIMED_OUT", "ACTION_STARTED",
        "BALLOT_CAST", "OVERRIDE_CAST", "FINDING_RAISED", "FINDING_CONFIRMED_REPAIRED",
        "FINDING_DISPROVED", "FINDING_ACCEPTED_BY_OWNER", "FINDING_SEVERITY_LOWERED",
        "DECISION_CLASS_LOWERED", "OWNER_REQUEST_OPENED", "OWNER_REQUEST_RESOLVED", "ACCEPTED",
        "PUBLISH_INTENT", "PUBLISH_COMPLETED", "PUBLISH_STALE", "REPAIR_ATTEMPT_STARTED",
        "REPAIR_BUDGET_EXHAUSTED", "RESOLVING_INCOMPLETE", "REVISE", "AMEND",
        "RUN_BUDGET_EXCEEDED", "RUN_RESUMED", "LAUNCH_FAILED", "INTEGRITY_VIOLATED", "BRIEFS_RECORDED", "BRIEF_RETRY_ATTEMPTED",
        "CRITERION_AMENDED", "CRITERION_REVERTED",
        "NOTE_ADDED", "OWNER_INPUT_RECORDED", "OWNER_CORRECTION", "OWNER_REQUEST_MARKED_UNNEEDED", "MISS_RECORDED", "NOTES_DELIVERED", "DECISION_MATCHED", "FINDING_ALSO_RAISED",
        "MESSAGE_RAISED", "MESSAGE_PUBLISHED", "MESSAGE_MERGED", "MESSAGE_DROPPED", "OWNER_VERDICT", "MESSAGE_RESOLVED", "MESSAGE_ADDRESS_REPORTED", "MESSAGE_SUPERSEDED", "MESSAGE_CARRIED",
        "ROUND_STARTED", "CANDIDATE_SUBMITTED", "CANDIDATE_CHECKED", "PICK_VOTE", "CANDIDATE_PICKED", "ROUND_REVIEW_SUBMITTED",
        "ITEM_CARRIED"
      ]
    }
  },
  "oneOf": [
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "ATTEMPT_STARTED" }, "baselineNeeded": { "type": "boolean" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "BASELINE_COMPLETED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "BASELINE_TIMED_OUT" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "BASELINE_INTERRUPTED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "EVALUATION_COMPLETED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "EVALUATION_TIMED_OUT" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "EVALUATION_INTERRUPTED" } } },
    { "type": "object", "required": ["type", "evaluated"], "properties": { "type": { "const": "EVALUATOR_FINISHED" }, "evaluated": { "type": "integer" } } },
    { "type": "object", "required": ["type", "blockerId", "seat", "vote", "reason"], "properties": { "type": { "const": "PANEL_VOTE" }, "blockerId": { "type": "string", "minLength": 1 }, "seat": { "type": "integer", "minimum": 1 }, "vote": { "enum": ["block", "downgrade"] }, "reason": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "blockerId", "seat"], "properties": { "type": { "const": "PANEL_SEAT_UNAVAILABLE" }, "blockerId": { "type": "string", "minLength": 1 }, "seat": { "type": "integer", "minimum": 1 }, "reason": { "type": "string" } } },
    { "type": "object", "required": ["type", "blockerId", "outcome"], "properties": { "type": { "const": "PANEL_DECIDED" }, "blockerId": { "type": "string", "minLength": 1 }, "outcome": { "enum": ["escalate", "downgrade", "incomplete"] }, "reason": { "type": "string" } } },
    { "type": "object", "required": ["type", "disclosures"], "properties": { "type": { "const": "SUBMIT_PHASE" }, "disclosures": { "type": "array" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "ATTEMPT_TIMED_OUT" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "ATTEMPT_NO_SUBMISSION" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "ATTEMPT_INTERRUPTED" } } },
    { "type": "object", "required": ["type", "candidateSha", "decisions"], "properties": { "type": { "const": "FREEZE_COMPLETED" }, "candidateSha": { "type": "string", "minLength": 1 }, "decisions": { "type": "array" }, "tainted": { "type": "boolean" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "FREEZE_TIMED_OUT" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "FREEZE_INTERRUPTED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "CHECKS_PASSED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "CHECKS_FAILED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "CHECKS_INTERRUPTED" } } },
    { "type": "object", "required": ["type", "probedI"], "properties": { "type": { "const": "PROBE_PASSED" }, "probedI": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "evidence"], "properties": { "type": { "const": "PROBE_FAILED" }, "evidence": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "PROBE_INTERRUPTED" } } },
    { "type": "object", "required": ["type", "review"], "properties": { "type": { "const": "REVIEW_SUBMITTED" }, "review": { "type": "object" } } },
    { "type": "object", "required": ["type", "reviewer"], "properties": { "type": { "const": "REVIEW_TIMED_OUT" }, "reviewer": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "action", "actionId"], "properties": { "type": { "const": "ACTION_STARTED" }, "action": { "type": "string", "minLength": 1 }, "actionId": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "ballot"], "properties": { "type": { "const": "BALLOT_CAST" }, "ballot": { "type": "object" } } },
    { "type": "object", "required": ["type", "override"], "properties": { "type": { "const": "OVERRIDE_CAST" }, "override": { "type": "object" } } },
    { "type": "object", "required": ["type", "finding"], "properties": { "type": { "const": "FINDING_RAISED" }, "finding": { "type": "object" } } },
    { "type": "object", "required": ["type", "findingId", "byReviewer", "candidateSha"], "properties": { "type": { "const": "FINDING_CONFIRMED_REPAIRED" }, "findingId": { "type": "string", "minLength": 1 }, "byReviewer": { "type": "string", "minLength": 1 }, "candidateSha": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "findingId", "byReviewer", "evidence"], "properties": { "type": { "const": "FINDING_DISPROVED" }, "findingId": { "type": "string", "minLength": 1 }, "byReviewer": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "findingId", "scope", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "FINDING_ACCEPTED_BY_OWNER" }, "findingId": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 }, "by": { "const": "owner" } } },
    { "type": "object", "required": ["type", "findingId", "severity", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "FINDING_SEVERITY_LOWERED" }, "findingId": { "type": "string", "minLength": 1 }, "severity": { "enum": ["blocking", "advisory"] }, "by": { "const": "owner" } } },
    { "type": "object", "required": ["type", "decisionId", "class", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "DECISION_CLASS_LOWERED" }, "decisionId": { "type": "string", "minLength": 1 }, "class": { "enum": ["detail", "delegated", "reserved"] }, "by": { "const": "owner" } } },
    { "type": "object", "required": ["type", "request"], "properties": { "type": { "const": "OWNER_REQUEST_OPENED" }, "request": { "type": "object" } } },
    { "type": "object", "required": ["type", "requestId", "option", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "OWNER_REQUEST_RESOLVED" }, "requestId": { "type": "string", "minLength": 1 }, "option": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "resolvedCorrectionIds"], "properties": { "type": { "const": "ACCEPTED" }, "resolvedCorrectionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    { "type": "object", "required": ["type", "expectedHead", "candidateI"], "properties": { "type": { "const": "PUBLISH_INTENT" }, "expectedHead": { "type": "string", "minLength": 1 }, "candidateI": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "newHead"], "properties": { "type": { "const": "PUBLISH_COMPLETED" }, "newHead": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "actualHead"], "properties": { "type": { "const": "PUBLISH_STALE" }, "actualHead": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "REPAIR_ATTEMPT_STARTED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "REPAIR_BUDGET_EXHAUSTED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "RESOLVING_INCOMPLETE" } } },
    { "type": "object", "required": ["type", "correctionId", "targetRecordId", "correctionText", "contractChange", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "REVISE" }, "correctionId": { "type": "string", "minLength": 1 }, "targetRecordId": { "type": "string", "minLength": 1 }, "correctionText": { "type": "string", "minLength": 1 }, "contractChange": { "type": "boolean" } } },
    { "type": "object", "required": ["type", "replacingContractVersion", "newContractVersion"], "properties": { "type": { "const": "AMEND" }, "replacingContractVersion": { "type": "object" }, "newContractVersion": { "type": "object" } } },
    { "type": "object", "required": ["type", "decisionId", "newAcceptance", "newContractVersion"], "properties": { "type": { "const": "CRITERION_AMENDED" }, "decisionId": { "type": "string", "minLength": 1 }, "newAcceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "newContractVersion": { "type": "object" } } },
    { "type": "object", "required": ["type", "amendmentId", "newAcceptance", "newContractVersion"], "properties": { "type": { "const": "CRITERION_REVERTED" }, "amendmentId": { "type": "string", "minLength": 1 }, "newAcceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "newContractVersion": { "type": "object" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "RUN_BUDGET_EXCEEDED" } } },
    { "type": "object", "required": ["type"], "properties": { "type": { "const": "RUN_RESUMED" } } },
    { "type": "object", "required": ["type", "role", "expected", "missing", "extra"], "properties": { "type": { "const": "LAUNCH_FAILED" }, "role": { "enum": ["worker", "reviewer", "evaluator", "panel"] }, "reviewer": { "type": "string", "minLength": 1 }, "expected": { "type": "array" }, "missing": { "type": "array" }, "extra": { "type": "array" } } },
    { "type": "object", "required": ["type", "stage"], "properties": { "type": { "const": "INTEGRITY_VIOLATED" }, "stage": { "type": "string", "minLength": 1 }, "evidence": { "type": "string" } } },
    { "type": "object", "required": ["type", "briefs"], "properties": { "type": { "const": "BRIEFS_RECORDED" }, "briefs": { "type": "array", "items": { "type": "object" } } } },
    { "type": "object", "required": ["type", "candidateSha", "requestIds"], "properties": { "type": { "const": "BRIEF_RETRY_ATTEMPTED" }, "candidateSha": { "type": "string" }, "requestIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    { "type": "object", "required": ["type", "phaseId", "text"], "properties": { "type": { "const": "NOTE_ADDED" }, "phaseId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "input"], "properties": { "type": { "const": "OWNER_INPUT_RECORDED" }, "input": { "type": "object" } } },
    { "type": "object", "required": ["type", "correctionId", "text"], "properties": { "type": { "const": "OWNER_CORRECTION" }, "correctionId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "requestId"], "properties": { "type": { "const": "OWNER_REQUEST_MARKED_UNNEEDED" }, "requestId": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "recordId"], "properties": { "type": { "const": "MISS_RECORDED" }, "recordId": { "type": "string", "minLength": 1 }, "sample": { "type": "string" } } },
    { "type": "object", "required": ["type", "phaseId", "count"], "properties": { "type": { "const": "NOTES_DELIVERED" }, "phaseId": { "type": "string", "minLength": 1 }, "count": { "type": "integer" } } },
    { "type": "object", "required": ["type", "decisionId", "sameAs", "reviewer"], "properties": { "type": { "const": "DECISION_MATCHED" }, "decisionId": { "type": "string", "minLength": 1 }, "sameAs": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "findingId", "reviewer"], "properties": { "type": { "const": "FINDING_ALSO_RAISED" }, "findingId": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "message"], "properties": { "type": { "const": "MESSAGE_RAISED" }, "message": { "type": "object" } } },
    { "type": "object", "required": ["type", "messageId", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_PUBLISHED" }, "messageId": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "messageId", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_MERGED" }, "messageId": { "type": "string", "minLength": 1 }, "by": { "enum": ["owner", "evaluator", "panel", "vote"] } } },
    { "type": "object", "required": ["type", "messageId", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_DROPPED" }, "messageId": { "type": "string", "minLength": 1 }, "by": { "enum": ["owner", "evaluator", "panel", "vote"] } } },
    { "type": "object", "required": ["type", "messageId", "verdict", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "OWNER_VERDICT" }, "messageId": { "type": "string", "minLength": 1 }, "verdict": { "enum": ["accept", "refuse"] } } },
    { "type": "object", "required": ["type", "messageId", "by", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_RESOLVED" }, "messageId": { "type": "string", "minLength": 1 }, "by": { "enum": ["owner", "evaluator", "panel", "vote"] } } },
    { "type": "object", "required": ["type", "messageId", "addressed", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_ADDRESS_REPORTED" }, "messageId": { "type": "string", "minLength": 1 }, "addressed": { "type": "boolean" }, "reason": { "type": "string" }, "at": { "type": "string" } } },
    { "type": "object", "required": ["type", "messageId", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "MESSAGE_SUPERSEDED" }, "messageId": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "messageId", "fromCandidate", "toCandidate", "fromVersion", "toVersion", "contentHash", "unchanged"], "properties": { "type": { "const": "MESSAGE_CARRIED" }, "messageId": { "type": "string", "minLength": 1 }, "fromCandidate": { "type": "string", "minLength": 1 }, "toCandidate": { "type": "string", "minLength": 1 }, "fromVersion": { "type": "integer" }, "toVersion": { "type": "integer" }, "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "unchanged": { "type": "boolean" }, "content": { "type": "object" } } },
    { "type": "object", "required": ["type", "round", "base", "lanes"], "properties": { "type": { "const": "ROUND_STARTED" }, "round": { "type": "integer", "minimum": 1 }, "base": { "type": "string", "minLength": 1 }, "lanes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    { "type": "object", "required": ["type", "round", "lane", "sha"], "properties": { "type": { "const": "CANDIDATE_SUBMITTED" }, "round": { "type": "integer", "minimum": 1 }, "lane": { "type": "string", "minLength": 1 }, "sha": { "type": "string", "minLength": 1 } } },
    { "type": "object", "required": ["type", "round", "lane", "ok"], "properties": { "type": { "const": "CANDIDATE_CHECKED" }, "round": { "type": "integer", "minimum": 1 }, "lane": { "type": "string", "minLength": 1 }, "ok": { "type": "boolean" }, "note": { "type": "string" } } },
    { "type": "object", "required": ["type", "round", "seat", "lane", "why"], "properties": { "type": { "const": "PICK_VOTE" }, "round": { "type": "integer", "minimum": 1 }, "seat": { "type": "string", "minLength": 1 }, "lane": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 }, "revote": { "type": "boolean", "description": "Plan 06h: true when this is the top-two revote turn" } } },
    { "type": "object", "required": ["type", "round", "lanes"], "properties": { "type": { "const": "REVOTE_STARTED" }, "round": { "type": "integer", "minimum": 1 }, "lanes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } } } },
    { "type": "object", "required": ["type", "round", "lane", "sha", "votes"], "properties": { "type": { "const": "CANDIDATE_PICKED" }, "round": { "type": "integer", "minimum": 1 }, "lane": { "type": "string", "minLength": 1 }, "sha": { "type": "string", "minLength": 1 }, "votes": { "type": "integer", "minimum": 0 } } },
    { "type": "object", "required": ["type", "round", "lane", "seat", "review"], "properties": { "type": { "const": "ROUND_REVIEW_SUBMITTED" }, "round": { "type": "integer", "minimum": 1 }, "lane": { "type": "string", "minLength": 1 }, "seat": { "type": "string", "minLength": 1 }, "review": { "type": "object" } } },
    { "type": "object", "required": ["type", "recordId", "toPhase", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"], "properties": { "type": { "const": "ITEM_CARRIED" }, "recordId": { "type": "string", "minLength": 1 }, "recordKind": { "enum": ["finding", "message"] }, "toPhase": { "type": "string", "minLength": 1 } } }
  ]
}
