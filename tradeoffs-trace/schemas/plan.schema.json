{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/plan",
  "title": "Plan",
  "description": "The JSON form Emacs emits from the plan Org file (design §1.1).",
  "type": "object",
  "required": ["title", "checks", "phases"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PlanPhase" }
    },
    "models": {
      "description": "#+TT_MODELS: an optional provider/model per role and per seat. A role or seat absent from the object keeps Pi's defaultModel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": { "$ref": "#/$defs/RoleModel" },
        "reviewer": { "$ref": "#/$defs/RoleModel" },
        "reviewerSeats": {
          "description": "Per-seat reviewer models (reviewer.M, reviewer.A, reviewer.B); a seat without one uses reviewer's.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "M": { "$ref": "#/$defs/RoleModel" },
            "A": { "$ref": "#/$defs/RoleModel" },
            "B": { "$ref": "#/$defs/RoleModel" }
          }
        },
        "evaluator": { "$ref": "#/$defs/RoleModel" },
        "panel": { "$ref": "#/$defs/RoleModel" },
        "panelSeats": {
          "description": "Per-seat panel models (panel.1, panel.2, panel.3); a seat without one uses the reviewer of its position when panelFrom is reviewers, else panel's.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": { "$ref": "#/$defs/RoleModel" },
            "2": { "$ref": "#/$defs/RoleModel" },
            "3": { "$ref": "#/$defs/RoleModel" }
          }
        },
        "panelFrom": {
          "description": "`panel=reviewers`: each panel seat follows the reviewer model of its position.",
          "type": "string",
          "enum": ["reviewers"]
        }
      }
    },
    "modelsLine": {
      "description": "Lint-only: the 1-based line of #+TT_MODELS in the source Org file.",
      "type": "integer"
    },
    "modelsRepeated": {
      "description": "Lint-only: roles #+TT_MODELS named more than once (a JSON object cannot carry a duplicate key).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modelsFromProgram": {
      "description": "A program entry only: roles its plan inherited from the program's #+TT_MODELS, already linted once at the program level.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rerun": {
      "description": "#+TT_RERUN: the single-test command newly failing tests are re-run with, using the {name} and {file} placeholders. Absent: the built-in Node/cargo defaults, or the strict rule.",
      "type": "string",
      "minLength": 1
    },
    "rerunLine": {
      "description": "Lint-only: the 1-based line of #+TT_RERUN in the source Org file.",
      "type": "integer"
    }
  },
  "$defs": {
    "PlanPhase": {
      "type": "object",
      "required": ["id", "goal", "checks", "boundaries", "reserved", "provisional"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reserved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provisional": { "type": "boolean" },
        "architecture": { "type": "array", "items": { "$ref": "#/$defs/ArchitectureItem" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/RequirementItem" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/ConstraintItem" } }
      }
    },
    "ArchitectureItem": {
      "description": "One architecture item (an :ID: subheading under Architecture).",
      "type": "object",
      "required": ["id", "title", "text", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "where": { "type": "string" },
        "whereLine": { "type": "integer" },
        "rawText": { "type": "string" },
        "line": { "type": "integer" }
      }
    },
    "RequirementItem": {
      "description": "One requirement item (an :ID: subheading under Requirements).",
      "type": "object",
      "required": ["id", "title", "text", "arch", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "arch": { "type": "array", "items": { "type": "string" } },
        "verify": { "type": "array", "items": { "type": "string" } },
        "rawText": { "type": "string" },
        "line": { "type": "integer" },
        "archLine": { "type": "integer" },
        "verifyLine": { "type": "integer" }
      }
    },
    "ConstraintItem": {
      "description": "One constraint item (an :ID: subheading under Constraints).",
      "type": "object",
      "required": ["id", "title", "text", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "verify": { "type": "array", "items": { "type": "string" } },
        "rawText": { "type": "string" },
        "line": { "type": "integer" },
        "verifyLine": { "type": "integer" }
      }
    },
    "RoleModel": {
      "description": "The provider and model a role runs with. Model ids may contain '/'.",
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
