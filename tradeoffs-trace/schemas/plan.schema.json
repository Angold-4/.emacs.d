{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/plan",
  "title": "Plan",
  "description": "The JSON form Emacs emits from the plan Org file (design §1.1).",
  "type": "object",
  "required": ["title", "checks", "phases"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PlanPhase" }
    },
    "models": {
      "description": "#+TT_MODELS: an optional provider/model per role. A role absent from the object keeps Pi's defaultModel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": { "$ref": "#/$defs/RoleModel" },
        "reviewer": { "$ref": "#/$defs/RoleModel" },
        "evaluator": { "$ref": "#/$defs/RoleModel" },
        "panel": { "$ref": "#/$defs/RoleModel" }
      }
    },
    "modelsLine": {
      "description": "Lint-only: the 1-based line of #+TT_MODELS in the source Org file.",
      "type": "integer"
    },
    "modelsRepeated": {
      "description": "Lint-only: roles #+TT_MODELS named more than once (a JSON object cannot carry a duplicate key).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modelsFromProgram": {
      "description": "A program entry only: roles its plan inherited from the program's #+TT_MODELS, already linted once at the program level.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "PlanPhase": {
      "type": "object",
      "required": ["id", "goal", "acceptance", "checks", "boundaries", "reserved", "provisional"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reserved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provisional": { "type": "boolean" }
      }
    },
    "RoleModel": {
      "description": "The provider and model a role runs with. Model ids may contain '/'.",
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
