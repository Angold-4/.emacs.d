{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/plan",
  "title": "Plan",
  "description": "The JSON form Emacs emits from the plan Org file (design §1.1).",
  "type": "object",
  "required": ["title", "checks", "phases"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PlanPhase" }
    }
  },
  "$defs": {
    "PlanPhase": {
      "type": "object",
      "required": ["id", "goal", "acceptance", "checks", "boundaries", "reserved", "provisional"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reserved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provisional": { "type": "boolean" }
      }
    }
  }
}
