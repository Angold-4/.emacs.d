{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/finding",
  "title": "Finding",
  "description": "design §4.1, §4.2.",
  "type": "object",
  "required": ["id", "version", "phaseId", "kind", "severity", "evidence", "raisedBy", "status", "boundCandidateSha"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer" },
    "phaseId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["defect", "contract", "integration"] },
    "severity": { "enum": ["blocking", "advisory"] },
    "evidence": { "type": "string", "minLength": 1 },
    "raisedBy": { "type": "string", "minLength": 1, "description": "Plan 06h: a seat name, or conductor/owner." },
    "linkedDecisionId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "repaired", "disproved", "accepted", "superseded"] },
    "boundCandidateSha": { "type": "string", "minLength": 1 },
    "reproduction": {
      "type": "object",
      "required": ["command", "result"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["reproduced", "not_reproduced", "inconclusive"] }
      }
    },
    "repairedByCandidateSha": { "type": "string", "minLength": 1 },
    "disprovedEvidence": { "type": "string", "minLength": 1 },
    "acceptedScope": { "type": "string", "minLength": 1 },
    "criterionDisputed": { "type": "string", "minLength": 1 },
    "supersededBy": { "type": "string", "minLength": 1 },
    "alsoRaisedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verified": { "type": "string", "minLength": 1 },
    "severityReason": { "type": "string", "minLength": 1 }
  }
}
