{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeoffs-trace/ballot",
  "title": "Ballot",
  "description": "design §5.1: a vote on a delegated decision, with rationale and at least one evidence citation.",
  "type": "object",
  "required": ["reviewer", "decisionId", "vote", "rationale", "evidence", "boundCandidateSha", "boundContractVersion", "boundRecordVersion"],
  "additionalProperties": true,
  "properties": {
    "reviewer": { "enum": ["M", "A", "B"] },
    "decisionId": { "type": "string", "minLength": 1 },
    "vote": { "enum": ["approve", "reject"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "contractObjection": { "type": "boolean" },
    "boundCandidateSha": { "type": "string", "minLength": 1 },
    "boundContractVersion": { "$ref": "#/$defs/ContractVersion" },
    "boundRecordVersion": { "type": "integer" }
  },
  "$defs": {
    "ContractVersion": {
      "type": "object",
      "required": ["snapshot", "sectionSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "type": "integer" },
        "sectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
